<Window x:Class="MenuPlanner.Views.AddIngredientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ингредиент" Width="400" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Top">
            <TextBlock Text="Название *" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtName" Height="35" Margin="0,0,0,15"/>

            <TextBlock Text="Ед. измерения *" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUnit" Height="35" Margin="0,0,0,15"/>

            <TextBlock Text="Цена" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtPrice" Height="35" Margin="0,0,0,15" PreviewTextInput="TxtPrice_PreviewTextInput"/>

            <TextBlock Text="Категория" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbCategory" Height="35" Margin="0,0,0,15" DisplayMemberPath="Name"/>

            <TextBlock Text="Срок хранения (дн.)" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtShelfLife" Height="35" Margin="0,0,0,15" PreviewTextInput="TxtPrice_PreviewTextInput"/>

            <CheckBox x:Name="chkActive" Content="Активен" IsChecked="True" Margin="0,0,0,20"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="100" Height="35" Margin="0,0,10,0" 
                    Click="BtnCancel_Click" Background="#757575" Foreground="White"/>
            <Button Content="Сохранить" Width="100" Height="35" 
                    Click="BtnSave_Click" Background="#FF6D00" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>