<Window x:Class="MenuPlanner.Views.SelectIngredientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выберите ингредиент" Width="700" Height="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="txtSearch" Width="400" Height="35" 
                     VerticalContentAlignment="Center" 
                     TextChanged="TxtSearch_TextChanged"/>
            <Button Content="Найти" Width="80" Height="35" Margin="10,0,0,0"
                    Click="BtnFind_Click"/>
        </StackPanel>

        <!-- Список ингредиентов -->
        <DataGrid x:Name="dgIngredients" 
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Background="White"
                  SelectionMode="Single"
                  MouseDoubleClick="DgIngredients_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="80"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding DefaultPrice, StringFormat={}{0:F2} ₽}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Количество и кнопки -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,10,0,0">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                    <TextBlock Text="Вес брутто (г):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="txtGrossWeight" Width="100" Height="35" 
                             PreviewTextInput="TxtDecimal_PreviewTextInput"
                             ToolTip="Вес продукта до обработки"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                    <TextBlock Text="Вес нетто (г):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="txtNetWeight" Width="100" Height="35" 
                             PreviewTextInput="TxtDecimal_PreviewTextInput"
                             ToolTip="Вес продукта после обработки"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Ед. измерения:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="txtUnit" Width="80" Height="35"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="100" Height="35" Margin="0,0,10,0" 
                        Click="BtnCancel_Click" Background="#757575" Foreground="White"/>
                <Button Content="Добавить" Width="100" Height="35" 
                        Click="BtnAdd_Click" Background="#FF6D00" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
