<Window x:Class="MenuPlanner.Views.AddRecipeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рецепт" Width="900" Height="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Основная информация -->
                <TextBlock Text="Название *" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtName" Height="35" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Номер рецепта" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtRecipeNumber" Height="35"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Источник" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtSource" Height="35"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Выход блюда (г)" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtYieldWeight" Height="35" PreviewTextInput="TxtDecimal_PreviewTextInput"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Базовое кол-во порций" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtBaseServings" Height="35" PreviewTextInput="TxtNumber_PreviewTextInput"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Технология приготовления" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtTechnology" Height="80" Margin="0,0,0,15" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Категория" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbCategory" Height="35" DisplayMemberPath="Name"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Статус" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbStatus" Height="35">
                            <ComboBoxItem Content="Активен" IsSelected="True"/>
                            <ComboBoxItem Content="Архив"/>
                            <ComboBoxItem Content="Черновик"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Ингредиенты рецепта -->
                <TextBlock Text="Ингредиенты" FontWeight="Bold" Margin="0,10,0,5"/>
                <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,10">
                    <DataGrid x:Name="dgRecipeIngredients" 
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Height="180"
                              Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ингредиент" Binding="{Binding IngredientName}" Width="200"/>
                            <DataGridTextColumn Header="Брутто (г)" Binding="{Binding GrossWeight, StringFormat=F2}" Width="80"/>
                            <DataGridTextColumn Header="Нетто (г)" Binding="{Binding NetWeight, StringFormat=F2}" Width="80"/>
                            <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="60"/>
                            <DataGridTextColumn Header="Цена за ед." Binding="{Binding PricePerUnit, StringFormat=F2}" Width="80"/>
                            <DataGridTextColumn Header="Стоимость" Binding="{Binding TotalCost, StringFormat=F2}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Content="+ Добавить ингредиент" Width="160" Height="30"
                            Click="BtnAddIngredient_Click" Background="#FF6D00" Foreground="White" BorderThickness="0"/>
                    <Button Content="Удалить" Width="100" Height="30" Margin="10,0,0,0"
                            Click="BtnRemoveIngredient_Click" Background="#F44336" Foreground="White" BorderThickness="0"/>
                </StackPanel>

                <!-- Итоги и ценообразование -->
                <Border BorderBrush="#FF6D00" BorderThickness="1" Background="#FFF3E0" 
                        CornerRadius="5" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="Себестоимость рецепта:" FontWeight="Bold"/>
                            <TextBlock x:Name="txtTotalCost" Text="0.00 ₽" FontWeight="Bold" FontSize="16" 
                                       Foreground="#FF6D00"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="Наценка (%):" FontWeight="Bold"/>
                            <TextBox x:Name="txtMarkupPercent" Height="30" Text="0" 
                                     PreviewTextInput="TxtDecimal_PreviewTextInput"
                                     TextChanged="TxtMarkupPercent_TextChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Цена продажи:" FontWeight="Bold"/>
                            <TextBlock x:Name="txtSellingPrice" Text="0.00 ₽" FontWeight="Bold" FontSize="16" 
                                       Foreground="#E65100"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="Цена за порцию:" FontWeight="Bold"/>
                            <TextBlock x:Name="txtCostPerPortion" Text="0.00 ₽" FontWeight="Bold" FontSize="16" 
                                       Foreground="#E65100"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Width="100" Height="35" Margin="0,0,10,0" 
                    Click="BtnCancel_Click" Background="#757575" Foreground="White"/>
            <Button Content="Сохранить" Width="100" Height="35" 
                    Click="BtnSave_Click" Background="#FF6D00" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
