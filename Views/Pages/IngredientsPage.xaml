<Page x:Class="MenuPlanner.Views.Pages.IngredientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Ингредиенты">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="600"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопка -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Ингредиенты" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="+ Добавить" Width="120" Height="35"
                    Background="#FF6D00" Foreground="White" BorderThickness="0"
                    Click="BtnAdd_Click"/>
        </Grid>

        <!-- Фильтры -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="txtSearch" Width="300" Height="35" Margin="0,0,10,0"
                     VerticalContentAlignment="Center" Tag="Поиск..."
                     TextChanged="txtSearch_TextChanged"/>
            <ComboBox x:Name="cmbCategory" Width="200" Height="35"
                      VerticalContentAlignment="Center"
                      SelectionChanged="cmbCategory_SelectionChanged">
                <ComboBoxItem Content="Все категории" IsSelected="True"/>
            </ComboBox>
            <Button Content="Сброс" Width="80" Height="35" Margin="10,0,0,0"
                    Click="BtnReset_Click"/>
        </StackPanel>

        <!-- DataGrid - БЕЗ ВИРТУАЛИЗАЦИИ -->
        <DataGrid x:Name="dgIngredients" 
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Background="White"
                  BorderBrush="Gray"
                  BorderThickness="1"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  RowHeight="35">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="80"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding DefaultPrice, StringFormat={}{0:C}}" Width="100"/>

                <!-- ✅ БЕЗОПАСНАЯ ПРИВЯЗКА КАТЕГОРИИ -->
                <DataGridTextColumn Header="Категория" 
                                    Binding="{Binding Categories.Name, TargetNullValue='—'}" 
                                    Width="150"/>

                <DataGridTextColumn Header="Срок (дн.)" Binding="{Binding ShelfLifeDays}" Width="90"/>

                <!-- ✅ СТАТУС С TargetNullValue -->
                <DataGridTextColumn Header="Статус" 
                                    Binding="{Binding IsActive, TargetNullValue=False}" 
                                    Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>