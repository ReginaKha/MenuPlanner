<Window x:Class="MenuPlanner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MenuPlanner"
        Height="800" Width="1200"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Боковое меню -->
            <ColumnDefinition Width="250"/>
            <!-- Основной контент -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== ЛЕВОЕ МЕНЮ ===== -->
        <Border Grid.Column="0" 
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип и имя пользователя -->
                <Border Grid.Row="0" Padding="7">
                    <StackPanel>
                        <TextBlock Text="🍽 MenuPlanner" 
                                   FontSize="20" 
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock x:Name="txtUserName" 
                                   Text="Иван Петров" 
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,5,0,0"/>
                        <TextBlock x:Name="txtUserRole" 
                                   Text="Повар" 
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Навигация -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MenuPanel">
                        <!-- Главная -->
                        <Button Content="📊 Главная" 
                                Tag="Dashboard"
                                Click="MenuButton_Click"
                                Style="{StaticResource {x:Type Button}}"
                                HorizontalContentAlignment="Left"
                                Padding="20,12"/>

                        <!-- Ингредиенты (все роли) -->
                        <Button Content="🥕 Ингредиенты" 
                                Tag="Ingredients"
                                Click="MenuButton_Click"
                                Style="{StaticResource {x:Type Button}}"
                                HorizontalContentAlignment="Left"
                                Padding="20,12"/>

                        <!-- Рецепты (все, кроме повара - только просмотр) -->
                        <Button Content="📖 Рецепты" 
                                Tag="Recipes"
                                Click="MenuButton_Click"
                                Style="{StaticResource {x:Type Button}}"
                                HorizontalContentAlignment="Left"
                                Padding="20,12"/>

                        <!-- Меню (шеф-повар) -->
                        <Button x:Name="btnMenu"
                                Content="📅 Меню" 
                                Tag="Menu"
                                Click="MenuButton_Click"
                                Style="{StaticResource {x:Type Button}}"
                                HorizontalContentAlignment="Left"
                                Padding="20,12"
                                Visibility="Collapsed"/>

                        <!-- Склад (кладовщик) -->
                        <Button x:Name="btnInventory"
                                Content="📦 Склад" 
                                Tag="Inventory"
                                Click="MenuButton_Click"
                                Style="{StaticResource {x:Type Button}}"
                                HorizontalContentAlignment="Left"
                                Padding="20,12"
                                Visibility="Collapsed"/>

                        <!-- Заявки (кладовщик, шеф) -->
                        <Button x:Name="btnPurchase"
                                Content="🛒 Заявки" 
                                Tag="PurchaseRequests"
                                Click="MenuButton_Click"
                                Style="{StaticResource {x:Type Button}}"
                                HorizontalContentAlignment="Left"
                                Padding="20,12"
                                Visibility="Collapsed"/>

                        <!-- Аналитика (бухгалтер, шеф, управляющий) -->
                        <Button x:Name="btnAnalytics"
                                Content="📈 Аналитика" 
                                Tag="Analytics"
                                Click="MenuButton_Click"
                                Style="{StaticResource {x:Type Button}}"
                                HorizontalContentAlignment="Left"
                                Padding="20,12"
                                Visibility="Collapsed"/>

                        <!-- Пользователи (админ) -->
                        <Button x:Name="btnUsers"
                                Content="👥 Пользователи" 
                                Tag="Users"
                                Click="MenuButton_Click"
                                Style="{StaticResource {x:Type Button}}"
                                HorizontalContentAlignment="Left"
                                Padding="20,12"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Низ: настройки и выход -->
                <Border Grid.Row="2" Padding="20" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Button Content="⚙️ Настройки" 
                                Tag="Settings"
                                Click="MenuButton_Click"
                                Style="{StaticResource OutlinedButtonStyle}"
                                HorizontalContentAlignment="Left"
                                Padding="20,10"
                                Margin="0,0,0,10"/>

                        <Button Content="🚪 Выйти" 
                                Click="BtnLogout_Click"
                                Style="{StaticResource DangerButtonStyle}"
                                HorizontalContentAlignment="Left"
                                Padding="20,10"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== ОСНОВНОЙ КОНТЕНТ ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0" 
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Заголовок страницы -->
                    <TextBlock x:Name="txtPageTitle" 
                               Text="Главная" 
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <!-- Переключатель темы и дата -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentDate, StringFormat={}{0:dd.MM.yyyy}}" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"/>

                        <Button Content="🌓" 
        Width="40" Height="40"
        Click="BtnToggleTheme_Click"
        ToolTip="Переключить тему"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Frame для страниц -->
            <Frame x:Name="MainFrame" 
                   Grid.Row="1" 
                   NavigationUIVisibility="Hidden"
                   Background="{StaticResource BackgroundBrush}"/>
        </Grid>
    </Grid>
</Window>