<Window x:Class="MenuPlanner.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MenuPlanner - Вход в систему"
        Height="600" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Border Margin="40" BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" Background="White">
        <StackPanel VerticalAlignment="Center">
            <!-- Логотип/Заголовок -->
            <TextBlock Text="🍽 MenuPlanner" 
                       FontSize="32" 
                       FontWeight="Bold"
                       Foreground="#2196F3"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <TextBlock Text="Вход в систему" 
                       FontSize="18"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Логин -->
            <TextBlock Text="Логин" 
                       Foreground="Black"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="txtLogin" 
                     Margin="0,0,0,20"
                     Tag="Введите логин"/>

            <!-- Пароль -->
            <TextBlock Text="Пароль" 
                       Foreground="Black"
                       Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" 
                         Margin="0,0,0,25"
                         Height="40"
                         VerticalContentAlignment="Center"/>

            <!-- Кнопка входа -->
            <Button Content="Войти" 
                    Height="44"
                    FontSize="16"
                    Margin="0,0,0,15"
                    Click="BtnLogin_Click"/>

            <TextBlock Text="Забыли пароль?" 
           HorizontalAlignment="Center" 
           Margin="0,10,0,0"
           Foreground="#2196F3"
           TextDecorations="Underline"
           Cursor="Hand"
           MouseLeftButtonUp="ForgotPassword_MouseLeftButtonUp"/>

            <!-- Сообщение об ошибке -->
            <TextBlock x:Name="txtErrorMessage" 
                       Foreground="Red"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <!-- После txtErrorMessage, перед закрывающим </StackPanel> -->
            <Button Content="🔹 Регистрация" 
        Margin="0,10,0,0"
        Click="BtnGoToRegister_Click"
        Background="Transparent"
        BorderBrush="#2196F3"
        BorderThickness="1"
        Foreground="#2196F3"/>
        </StackPanel>
    </Border>
</Window>